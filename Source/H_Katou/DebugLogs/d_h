    // DX 描画の種類を管理する列挙型。
    // 点、線、円、矩形、テキストなどの描画形式を識別する。
    enum DrawType
    {
        DrawType_Point,
        DrawType_Line,
        DrawType_Circle,
        DrawType_Rectangle,
        DrawType_Text,
        DrawType_FillCircle,
        DrawType_FillRectangle
    };
        
    // StructMemberIndexData は構造体のメンバ変数をデバッグ表示用に束ねる情報を持つ。
    // 例: position.x のような階層メンバも、名前とポインタの組み合わせで1つのデバッグ項目として扱える。
    struct StructMemberIndexData
    {
        std::string Name;
        void* (*GetPointer)(void* objectPtr);
    };

    template <typename T, typename MemberType>
    StructMemberIndexData MakeStructMemberIndexData(const std::string& nameValue, MemberType T::* member)
    {
        return
        {
            nameValue,
            [member](void* objectPtr) -> void*
            {
                T* object = static_cast<T*>(objectPtr);
                return &(object->*member);
            }
        };
    }

