    void SetBasicEnabled(const std::string& key, bool enabled)
    {
        auto& entries = PrivateVariable::GetEntries();
        for (auto& entry : entries)
        {
            if (entry.key == key)
            {
                entry.basicEnabled = enabled;
                if (entry.drawState)
                {
                    for (auto& setting : entry.drawState->settings)
                    {
                        setting.basicEnabled = enabled;
                    }
                    if (!entry.drawState->settings.empty())
                    {
                        entry.drawSetting = entry.drawState->settings.front();
                    }
                }
                entry.drawSettings = entry.drawState ? entry.drawState->settings : entry.drawSettings;
                return;
            }
        }
    }

    void SetTypeEnabled(const std::string& key, DrawType type, bool enabled)
    {
        auto& entries = PrivateVariable::GetEntries();
        for (auto& entry : entries)
        {
            if (entry.key == key)
            {
                entry.typeEnabled = enabled;
                if (entry.drawState)
                {
                    for (auto& setting : entry.drawState->settings)
                    {
                        if (setting.type == type)
                        {
                            setting.typeEnabled = enabled;
                        }
                    }
                    if (!entry.drawState->settings.empty())
                    {
                        entry.drawSetting = entry.drawState->settings.front();
                    }
                }
                entry.drawSettings = entry.drawState ? entry.drawState->settings : entry.drawSettings;
                return;
            }
        }
    }

    void SetElementEnabled(const std::string& key, bool enabled, size_t elementIndex)
    {
        auto& entries = PrivateVariable::GetEntries();
        for (auto& entry : entries)
        {
            if (entry.key == key)
            {
                if (entry.drawState && elementIndex < entry.drawState->settings.size())
                {
                    entry.drawState->settings[elementIndex].elementEnabled = enabled;
                    entry.drawSetting = entry.drawState->settings.front();
                }
                entry.drawSettings = entry.drawState ? entry.drawState->settings : entry.drawSettings;
                return;
            }
        }
    }

    void SetDefaultDrawSetting(const std::string& key, const DrawSetting& setting)
    {
        auto& entries = PrivateVariable::GetEntries();
        for (auto& entry : entries)
        {
            if (entry.key == key)
            {
                if (entry.drawState == nullptr)
                {
                    entry.drawState = std::make_shared<LiveDrawState>(setting);
                }
                else
                {
                    entry.drawState->mainSetting = setting;
                    entry.drawState->settings.assign(1, setting);
                }
                entry.drawSetting = setting;
                entry.drawSettings = entry.drawState->settings;
                return;
            }
        }
    }

