        void Update()
        {
            auto& entries = PrivateVariable::GetEntries();
            for (auto& entry : entries)
            {
                if (entry.updateImgui)
                {
                    entry.updateImgui();
                }
            }

            if (!ImGui::Begin("DebugVariableToImgui"))
            {
                ImGui::End();
                return;
            }

            if (ImGui::BeginTabBar("DebugVariableToImguiTabBar"))
            {
                if (ImGui::BeginTabItem("Basic"))
                {
                    if (entries.empty())
                    {
                        ImGui::TextUnformatted("No debug variables registered.");
                    }
                    else
                    {
                        for (auto& entry : entries)
                        {
                            PrivateDetail::DrawEntrySettingEditor(entry);
                        }
                    }
                    ImGui::EndTabItem();
                }

                if (ImGui::BeginTabItem("Point"))
                {
                    PrivateDetail::DrawTypeTab(DrawType_Point);
                    ImGui::EndTabItem();
                }
                if (ImGui::BeginTabItem("Line"))
                {
                    PrivateDetail::DrawTypeTab(DrawType_Line);
                    ImGui::EndTabItem();
                }
                if (ImGui::BeginTabItem("Circle"))
                {
                    PrivateDetail::DrawTypeTab(DrawType_Circle);
                    ImGui::EndTabItem();
                }
                if (ImGui::BeginTabItem("Rectangle"))
                {
                    PrivateDetail::DrawTypeTab(DrawType_Rectangle);
                    ImGui::EndTabItem();
                }
                if (ImGui::BeginTabItem("Text"))
                {
                    PrivateDetail::DrawTypeTab(DrawType_Text);
                    ImGui::EndTabItem();
                }

                ImGui::EndTabBar();
            }

            ImGui::End();
        }

        void Draw()
        {
            auto& entries = PrivateVariable::GetEntries();
            constexpr int startX = 20;
            constexpr int startY = 24;
            constexpr int textLineHeight = 24;
            constexpr int textColumnGap = 1;
            constexpr int maxRowsPerColumn = 18;
            int globalTextIndex = 0;

            for (auto& entry : entries)
            {
                if (!entry.drawState || entry.drawState->settings.empty())
                {
                    continue;
                }

                bool hasTextSetting = false;
                for (const auto& setting : entry.drawState->settings)
                {
                    if (setting.type == DrawType_Text && setting.IsVisible())
                    {
                        hasTextSetting = true;
                        break;
                    }
                }

                if (hasTextSetting && entry.getDisplayValue)
                {
                    const std::string valueText = entry.getDisplayValue();
                    for (size_t i = 0; i < entry.drawState->settings.size(); ++i)
                    {
                        const DrawSetting& setting = entry.drawState->settings[i];
                        if (setting.type != DrawType_Text || !setting.IsVisible())
                        {
                            continue;
                        }

                        const int columnIndex = globalTextIndex / maxRowsPerColumn;
                        const int rowIndex = globalTextIndex % maxRowsPerColumn;
                        const int drawX = startX + columnIndex * textColumnGap;
                        const int drawY = startY + rowIndex * textLineHeight;
                        const std::string displayText = setting.label.empty() ? (setting.text.empty() ? valueText : setting.text + ": " + valueText) : setting.label + ": " + valueText;

                        DxLib::DrawString(drawX, drawY, displayText.c_str(), setting.color);
                        ++globalTextIndex;
                    }
                    continue;
                }

                if (entry.drawDx)
                {
                    entry.drawDx();
                }
            }
        }
